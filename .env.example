# =============================================================================
# Plantilla de variables de entorno — Gestión de Activos TI
# Grupo Empresarial Dinámica S.A.S.
#
# Copiar como ".env" y completar con valores reales. El .env NUNCA se sube a git.
#   cp .env.example .env
# =============================================================================

# Puerto público de la aplicación (la VM expone APP_PORT -> 3001 interno)
PORT=3001
APP_PORT=3001
APP_URL=http://localhost:3001

# --- Base de datos MariaDB ---
# En despliegue con compose, DB_HOST debe ser "db" (nombre del servicio).
# En desarrollo local con Podman, usar 127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_NAME=inventario_computo

# Alternativa con URL única (tiene prioridad si se define):
# DATABASE_URL=mysql://root:CAMBIAR_ESTA_CLAVE@db:3306/inventario_computo

# --- Seguridad de tokens JWT (OBLIGATORIO en producción) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=PEGAR_AQUI_EL_VALOR_GENERADO
